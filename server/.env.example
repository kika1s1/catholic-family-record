NODE_ENV=production
PORT=4000

# Public site URL (no trailing slash) — used for CORS / cookies
CLIENT_ORIGIN=https://your-domain.com

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Created on first boot if the user does not already exist
ADMIN_EMAIL=you@yourdiocese.org
ADMIN_PASSWORD=replace-with-a-strong-password

# false for plain HTTP (IP) deploys; true (default in production) behind HTTPS
COOKIE_SECURE=false
