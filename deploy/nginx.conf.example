# Example Nginx reverse proxy for The Catholic Family Record
# 1. Copy to /etc/nginx/sites-available/cfr
# 2. Replace your-domain.com
# 3. ln -s /etc/nginx/sites-available/cfr /etc/nginx/sites-enabled/
# 4. certbot --nginx -d your-domain.com
# 5. nginx -t && systemctl reload nginx

upstream cfr_app {
    server 127.0.0.1:4000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com;

    # Certbot will add HTTPS; until then you can keep this redirect after TLS is ready
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://cfr_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 2m;
    }
}

# After certbot, you typically get a TLS server block. Keep the same proxy_pass settings.
